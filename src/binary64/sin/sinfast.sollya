d0 = [0.00001,0.5];
d = [-0.5,0.5];
f = sin(x/2^12);
p = fpminimax(f, [|1,3|], [|53...|], d0, absolute, floating);
display = hexadecimal;
print (p);
err_p = dirtyinfnorm(p-f, d);
display = decimal;
print (err_p);

f = cos(x/2^12)-1;
p = fpminimax(f, [|2,4|], [|53...|], d, absolute, floating);
display = hexadecimal;
print (p);
err_p = dirtyinfnorm(p-f, d);
display = decimal;
print (err_p);
