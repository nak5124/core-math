d0 = [0.00001,2^-13];
d = [-2^-13,2^-13];
f = sin(x);
p = fpminimax(f, [|1,3|], [|53...|], d0, absolute, floating);
display = hexadecimal;
print (p);
err_p = dirtyinfnorm(p-f, d);
display = decimal;
print (err_p);

f = cos(x)-1;
p = fpminimax(f, [|2,4|], [|53...|], d, absolute, floating);
display = hexadecimal;
print (p);
err_p = dirtyinfnorm(p-f, d);
display = decimal;
print (err_p);
